{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "TodoWrite",
      "NotebookEdit",
      "AskUserQuestion",
      "ScheduleWakeup",
      "Skill",
      "ToolSearch"
    ],
    "deny": [],
    "additionalDirectories": [
      "C:\\Users\\Директор\\AppData\\Roaming\\chat-center",
      "C:\\Users\\Директор\\AppData\\Roaming",
      "C:\\Users\\Директор\\AppData\\Local\\Temp"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/check-size-hook.cjs",
            "timeout": 15,
            "statusMessage": "Проверка лимитов файлов кода..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/check-size-hook.cjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
