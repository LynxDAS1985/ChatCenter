#!/bin/bash
# v0.87.80: pre-push hook — запускает все cjs-тесты + vitest перед push.
# Если что-то упало — push блокируется (та же цепочка что в GitHub Actions CI).
#
# Установка: npm run setup-hooks (вызывается автоматически через postinstall).
# Ручной запуск: npm run pre-push.
#
# ВАЖНО: НЕ запускает electron-vite build и e2e — они требуют Electron,
# что запрещено правилами CLAUDE.md в Claude Code. Полная цепочка `npm test`
# прогоняется только в CI на GitHub.
#
# Обход: git push --no-verify (ЗАПРЕЩЕНО правилами без явного разрешения).

set -u

echo ""
echo "🛡  pre-push: локальные проверки (список тестов берётся из package.json — как в CI)..."
echo ""

# 🔴 v1.2.451: СПИСОК ТЕСТОВ БОЛЬШЕ НЕ ХРАНИТСЯ ЗДЕСЬ. Он читается из package.json —
# оттуда же, откуда его берёт сборка на сервере (CI). Раньше тут лежала КОПИЯ списка,
# и она разошлась: хук гонял 36 тестов, CI — 45. Из-за этого 10 сентября 2026 отправка
# прошла локально «зелёной», а сборка на сервере упала на тесте, которого в хуке не было.
# Теперь список один, и разойтись ему негде.
#
# Берём только обычные тесты (node src/__tests__/*.test.cjs). Всё остальное из цепочки
# CI — vitest (запускается ниже), сборка и e2e — здесь НЕ запускается: e2e поднимает
# Electron, а это запрещено правилами проекта.
TESTS=($(node -e "const p=require('./package.json');const m=(p.scripts&&p.scripts.test||'').match(/src\/__tests__\/[A-Za-z0-9_]+\.test\.cjs/g)||[];console.log([...new Set(m.map(x=>x.split('/').pop().replace('.test.cjs','')))].join(' '))"))

if [ ${#TESTS[@]} -eq 0 ]; then
  echo "❌ pre-push: не смог прочитать список тестов из package.json (scripts.test)."
  echo "   Проверь, что package.json на месте и в scripts.test есть node src/__tests__/*.test.cjs"
  echo "🚫 PUSH ЗАБЛОКИРОВАН (лучше остановиться, чем отправить непроверенное)."
  exit 1
fi

TOTAL=${#TESTS[@]}
i=0
for t in "${TESTS[@]}"; do
  i=$((i + 1))
  printf "  [%2d/%d] %s ... " "$i" "$TOTAL" "$t"
  if node "src/__tests__/$t.test.cjs" > /tmp/cc-pp-out.log 2>&1; then
    echo "✅"
  else
    echo "❌"
    echo ""
    echo "════════════════════════════════════════════════════════════"
    echo "❌ pre-push: тест '$t' упал"
    echo "════════════════════════════════════════════════════════════"
    tail -20 /tmp/cc-pp-out.log
    echo "════════════════════════════════════════════════════════════"
    echo ""
    echo "🚫 PUSH ЗАБЛОКИРОВАН. Чини тест и пробуй снова."
    echo "   Обход: git push --no-verify (ЗАПРЕЩЕНО без разрешения)"
    echo ""
    rm -f /tmp/cc-pp-out.log
    exit 1
  fi
done

echo ""
echo "  ✅ Все $TOTAL cjs-тестов прошли"
echo ""
echo "  [vitest] запуск ..."
if npm run test:vitest --silent > /tmp/cc-pp-vitest.log 2>&1; then
  RESULT=$(grep -E "Tests" /tmp/cc-pp-vitest.log | tail -1)
  echo "  ✅ vitest: $RESULT"
else
  echo "  ❌ vitest упал"
  echo ""
  echo "════════════════════════════════════════════════════════════"
  tail -30 /tmp/cc-pp-vitest.log
  echo "════════════════════════════════════════════════════════════"
  echo ""
  echo "🚫 PUSH ЗАБЛОКИРОВАН."
  rm -f /tmp/cc-pp-vitest.log
  exit 1
fi

rm -f /tmp/cc-pp-out.log /tmp/cc-pp-vitest.log
echo ""
echo "✅ pre-push: всё зелёное — push разрешён"
echo ""
exit 0
