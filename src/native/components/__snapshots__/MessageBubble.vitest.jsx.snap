exports[`MessageBubble render > snapshot: исходящее медиа-фото с подписью 1`] = `"<div data-msg-id="99" style="align-self: flex-end; max-width: 420px; min-width: 280px; width: auto; position: relative;"><div data-cc-outgoing="true" style="padding: 4px; border-radius: 12px; background: var(--amoled-accent); color: #fff; font-size: 14px; word-break: break-word; border: none none; box-shadow: 0 0 12px var(--amoled-accent-shadow, rgba(42,171,238,0.15)); opacity: var(--bubble-opacity, 1);"><div style="position: relative; width: 100%; aspect-ratio: 1000 / 750; min-height: 180px; max-height: 420px; border-radius: 8px; margin-bottom: 6px; overflow: hidden; background: url(&quot;data:image/jpeg;base64,xxxx&quot;) center center / cover no-repeat; cursor: default;"><div style="position: absolute; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, 0.2); color: #fff; font-size: 11px;"><span class="native-spinner"></span></div></div><div style="white-space: pre-wrap; padding: 4px 8px 0px;">Смотри</div><div style="font-size: 10px; opacity: 0.75; margin-top: 2px; text-align: right; padding: 2px 8px 4px;">19:33<span style="margin-left: 3px; display: inline-flex; vertical-align: middle;" title="Отправлено"><svg width="13" height="11" viewBox="0 0 13 11" fill="none" style="display: block;"><path d="M1 6 L4.5 9.5 L11.5 1.5" stroke="rgba(255,255,255,0.65)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></div></div></div>"`;

exports[`MessageBubble render > snapshot: типичное текстовое сообщение (визуальная регрессия) 1`] = `"<div data-msg-id="1" style="align-self: flex-start; max-width: 100%; min-width: auto; width: auto; position: relative;"><div style="padding: 8px 12px; border-radius: 12px; background: var(--amoled-surface-hover); color: var(--amoled-text); font-size: 14px; word-break: break-word; border: 1px solid rgba(255, 255, 255, 0.06); box-shadow: none; opacity: var(--bubble-opacity, 1);"><div style="display: flex; align-items: flex-end; gap: 6px;"><div style="white-space: pre-wrap; flex-grow: 1; flex-shrink: 1; flex-basis: 0%;">Привет</div><div style="font-size: 10px; opacity: 0.7; flex-shrink: 0; white-space: nowrap; margin-bottom: 1px;">19:33</div></div></div></div>"`;
